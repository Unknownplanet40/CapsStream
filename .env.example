# ── CapsStream secrets ────────────────────────────────────────
# Copy this file to ".env" and fill in your real keys.
# ".env" is gitignored and must NEVER be committed.

# TMDb (main metadata provider) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OMDb (fallback ratings/IDs) — https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
